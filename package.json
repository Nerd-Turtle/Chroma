{
  "name": "chroma",
  "version": "0.3.1",
  "description": "Chroma Server Manager is a Minecraft Bedrock Dedicated Server and addon manager.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1 src/web",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "build:web": "vite build src/web",
    "preview:web": "vite preview --host 127.0.0.1",
    "build:release": "./dev/scripts/build-release.sh"
  },
  "keywords": [
    "minecraft",
    "bedrock",
    "server",
    "addons",
    "curseforge"
  ],
  "author": "Nerd Turtle",
  "license": "MIT",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.7",
    "lucide-react": "^0.542.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
