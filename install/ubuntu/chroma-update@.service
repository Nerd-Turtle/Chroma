[Unit]
Description=Install a verified stable Chroma upgrade
CollectMode=inactive-or-failed

[Service]
Type=exec
User=root
Group=root
WorkingDirectory=/opt/chroma/current/app
Environment=NODE_ENV=production
ExecStart=/usr/bin/flock --nonblock /opt/chroma/update-state/install.lock /opt/chroma/current/node/bin/node /opt/chroma/current/app/dist/server/updates/updateWorker.js
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=30min
TimeoutStopSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0022
